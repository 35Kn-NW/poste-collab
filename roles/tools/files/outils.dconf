# Géré par linux-collab : la touche Calculatrice ouvre Qalculate! (cf. docs/NOTES.md §13).
[org/gnome/settings-daemon/plugins/media-keys]
calculator=@as []
calculator-static=@as []
custom-keybindings=['/org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/qalculate/']

[org/gnome/settings-daemon/plugins/media-keys/custom-keybindings/qalculate]
name='Qalculate!'
command='qalculate-gtk'
binding='XF86Calculator'
